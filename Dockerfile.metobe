# syntax=docker/dockerfile:1
# Our fork's masking service for Metobe (docs/ru/README.md; Metobe docs/PII-GUARD-PLAN.md З1):
# fast mode only — the rules, the Russian pack (pymorphy3, its dictionaries, pytrovich) and the
# NER on CPU with our Russian checkpoint baked in, so it works offline and the model's version is
# the image's. No image masking: Metobe sends images as they are.
#
# The weights are not in the build context (.dockerignore keeps models/ out); pass their folder
# as a named context:
#
#   docker build -f Dockerfile.metobe \
#     --build-context model=models/ner/pii-guard-ner-xlmr-base-ru-s34 \
#     -t pii-guard-metobe .

FROM ghcr.io/astral-sh/uv:0.13.7-python3.12-trixie-slim AS build

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

# Dependencies first, so code changes don't invalidate this layer. torch comes from the CPU index
# on Linux (pyproject.toml), not the CUDA wheel.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --no-dev --extra ru --no-install-project

COPY pyproject.toml uv.lock README.md LICENSE NOTICE ./
COPY src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --extra ru --no-editable

FROM python:3.12-slim-trixie AS runtime

RUN groupadd --system piiguard && useradd --system --gid piiguard --home /app piiguard

COPY --from=build --chown=piiguard:piiguard /app/.venv /app/.venv
COPY --from=model --chown=piiguard:piiguard . /app/models/ner/ru

# Fast mode, Russian by default, the baked NER and never a download. The API listens inside the
# compose network only; Metobe sends PII_GUARD_API_TOKEN as x-pii-guard-token.
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HUB_OFFLINE=1 \
    PII_GUARD_HOST=0.0.0.0 \
    PII_GUARD_PORT=8787 \
    PII_GUARD_DEFAULT_LANGUAGE=ru \
    PII_GUARD_NER_MODEL=/app/models/ner/ru \
    PII_GUARD_NER_FALLBACK=off \
    PII_GUARD_MODEL_DIR=/app/models

WORKDIR /app
USER piiguard
EXPOSE 8787

# Healthy once the NER has loaded: before that the guard refuses to mask (fail closed).
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=4 \
    CMD ["python", "-c", "import json, os, sys, urllib.request; r = json.load(urllib.request.urlopen(f\"http://127.0.0.1:{os.environ['PII_GUARD_PORT']}/healthz\", timeout=2)); sys.exit(0 if r.get('ner') == 'ready' else 1)"]

CMD ["pii-guard", "serve"]
